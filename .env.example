TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here
ADMIN_IDS=123456789,987654321
GEMINI_MODEL=gemini-3.6-flash
SYSTEM_PROMPT=You are a helpful Telegram assistant.
PROVIDER=auto
PROVIDER_ORDER=gemini,openrouter_free,deepseek,hf,ollama
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_REFERER=https://your-site.example
OPENROUTER_TITLE=Gemini Telegram Bot
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
HF_API_KEY=your_huggingface_token_here
HF_MODEL=DavidAU/Qwen3.5-9B-Claude-4.6-HighIQ-THINKING-HERETIC-UNCENSORED
HF_BASE_URL=https://api-inference.huggingface.co/v1
HF_MAX_TOKENS=2048
NOTES_DB_PATH=notes_data.json
GROUPS_DB_PATH=groups_data.json
THAILAND_TIMEZONE=Asia/Bangkok

# Railway persistent volume path (set automatically when volume is attached)
# RAILWAY_VOLUME_PATH=/data
# Or set manually:
# DATA_VOLUME_PATH=/data
